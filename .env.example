SWITCH_URL=
SWITCH_AGENT_ID=
SWITCH_API_KEY=
ANTHROPIC_API_KEY=
DISCORD_RELAY_TOKEN=
KRAKEN_RELAY_SECRET=
# One-time token for scripts/register.py (Switch registration)
SWITCH_REGISTRATION_TOKEN=
# Agent id of the kraken-smoke agent, used by scripts/smoke.py only
SMOKE_AGENT_ID=
# API key of the kraken-smoke agent, used by scripts/smoke.py only
SMOKE_API_KEY=
# Kraken's own model (any vendor). auto = the first one set up: an API key below, then a
# signed-in agent CLI (claude, codex, opencode, gemini). Or pick one: claude-code, codex,
# opencode, gemini-cli, openai, gemini, api, cli. See "Kraken's own model" in the README.
KRAKEN_LLM=auto
# Model name for the backend you picked (optional for agent CLIs)
KRAKEN_LLM_MODEL=
# OpenAI-compatible APIs (OpenAI, OpenRouter, Groq, Ollama at http://localhost:11434/v1, ...)
KRAKEN_LLM_BASE_URL=
KRAKEN_LLM_API_KEY=
GEMINI_API_KEY=
# For KRAKEN_LLM=cli: any command; the prompt goes on stdin or where {prompt} is
KRAKEN_LLM_CMD=
